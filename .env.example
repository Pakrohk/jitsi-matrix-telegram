# Telegram Bot
TELEGRAM_TOKEN=your_bot_token_here

# Matrix Bot
MATRIX_HOMESERVER=https://matrix.example.com
MATRIX_USER=@bot:example.com
MATRIX_PASSWORD=your_password_here

# Jitsi Server
JITSI_SERVER_URL=https://meet.example.com
JITSI_MUC_DOMAIN=conference.meet.example.com
JITSI_ADMIN_USERNAME=admin
JITSI_ADMIN_PASSWORD=admin_password

# Storage
STORAGE_DB_PATH=jitsi-bot.db

# Gateway
GATEWAY_PORT=8000

# Proxy (optional)
PROXY_ENABLED=false
PROXY_TYPE=socks5
PROXY_HOST=127.0.0.1
PROXY_PORT=1080
# PROXY_USERNAME=
# PROXY_PASSWORD=
