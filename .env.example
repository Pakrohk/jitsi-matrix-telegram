# Telegram Bot
TELEGRAM_TOKEN=your_bot_token_here

# Matrix Bot
MATRIX_HOMESERVER=https://matrix.example.com
MATRIX_USER=@bot:example.com
MATRIX_PASSWORD=your_password_here

# Jitsi Server Configuration
JITSI_DOMAIN=localhost
JITSI_SERVER_URL=https://localhost:8443
JITSI_MUC_DOMAIN=jitsi-meet.example.com

# Jitsi Docker Secrets (change these!)
JICOFO_COMPONENT_SECRET=secret
JICOFO_AUTH_PASSWORD=pass
JVB_AUTH_PASSWORD=pass
JVB_SECRET=secret

# Storage
STORAGE_DB_PATH=jitsi-bot.db

# Gateway
GATEWAY_PORT=9000

# Proxy (optional)
PROXY_ENABLED=false
PROXY_TYPE=socks5
PROXY_HOST=127.0.0.1
PROXY_PORT=1080
# PROXY_USERNAME=
# PROXY_PASSWORD=
